{
  "name": "medexplain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "start:server": "node server/src/server.js",
    "mobile": "npm start --prefix medex-mobile",
    "mobile:android": "npm run android --prefix medex-mobile",
    "mobile:web": "npm run web --prefix medex-mobile",
    "build": "vite build",
    "start": "node server/src/server.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.13",
    "@supabase/supabase-js": "^2.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "agora-token": "^2.0.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^20.5.0",
    "googleapis": "^144.0.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
