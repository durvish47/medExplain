# ============================================
# Healthcare API - Environment Configuration
# ============================================
# No API keys needed! Everything is free & open.

# Server
PORT=3000

# Default location (Chennai, Tamil Nadu)
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707

# Search radius in meters (default: 10km)
SEARCH_RADIUS=10000

# ============================================
# OpenStreetMap (No API key required)
# ============================================
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
